# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# For local development: file:./data/app.db
# For Turso: libsql://<db>.turso.io
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Authentication
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Storage
# STORAGE_DRIVER=local (default) or s3
STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads
MAX_FILE_SIZE=52428800

# S3-compatible uploads (required when STORAGE_DRIVER=s3)
# Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
# S3_BUCKET=base-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PREFIX=uploads/
# FILES_DOWNLOAD_MODE=proxy   # proxy (default) | redirect (presigned URL — recommended in production)
# S3_PRESIGN_EXPIRES=300

# CORS
# Development may use "*". Production requires an explicit list when using cookies.
# Example: http://localhost:3000,https://example.com
CORS_ORIGINS=*

# Hard delete (?hard=true) — disabled by default
HARD_DELETE_ENABLED=false

# Realtime (SSE collection-change subscriptions)
REALTIME_ENABLED=true
REALTIME_REPLAY_BUFFER=100

# Litestream (optional DB replication) — see litestream.yml
# Shares the same S3_* credential names as file uploads when you use one
# S3-compatible endpoint for both, but uses a separate bucket:
# LITESTREAM_BUCKET=
# S3_ENDPOINT=          # shared with uploads if STORAGE_DRIVER=s3
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
