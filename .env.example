# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# For local development: file:./data/app.db
# For Turso: libsql://<db>.turso.io
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Authentication
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# Settings encryption master key (optional).
# If unset, derived from BETTER_AUTH_SECRET (or a local data/.base-master-key file).
# For multi-node / production, set explicitly: openssl rand -base64 32
# BASE_MASTER_KEY=
# BASE_MASTER_KEY_FILE=./data/.base-master-key

# Admin control plane
ADMIN_ENABLED=true
ADMIN_PATH=/_
# Break-glass token (min 32 chars). Prefer role=admin users for day-to-day.
# ADMIN_TOKEN=
# Comma-separated emails auto-promoted to admin on sign-up
# ADMIN_EMAILS=you@example.com

# Storage
# STORAGE_DRIVER=local (default) or s3
STORAGE_DRIVER=local
STORAGE_PATH=./data/uploads
MAX_FILE_SIZE=52428800

# S3-compatible uploads (required when STORAGE_DRIVER=s3)
# S3_BUCKET=base-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PREFIX=uploads/
# FILES_DOWNLOAD_MODE=proxy   # proxy (default) | redirect
# S3_PRESIGN_EXPIRES=300

# CORS
# Development may use "*". Production requires an explicit list when using cookies.
CORS_ORIGINS=*

# Hard delete (?hard=true) — disabled by default
HARD_DELETE_ENABLED=false

# Realtime (SSE collection-change subscriptions)
REALTIME_ENABLED=true
REALTIME_REPLAY_BUFFER=100

# Logging
LOG_LEVEL=info
LOG_PERSIST=true
LOG_BUFFER_SIZE=500
LOG_RETENTION_DAYS=14

# Backups
BACKUP_DIR=./data/backups
BACKUP_RETENTION=10
# 0 = disabled; otherwise create a backup every N hours
BACKUP_SCHEDULE_HOURS=0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20

# Webhooks (outbound change delivery)
WEBHOOKS_ENABLED=false

# Litestream (optional DB replication) — see litestream.yml
# LITESTREAM_BUCKET=
# LITESTREAM_DB_PATH=./data/app.db
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
