{
  "name": "@base/core",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "base": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index-public.ts",
    "./schema": "./src/schema/define.ts",
    "./client": "./src/client/generated.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --concurrency=1",
    "typecheck": "tsc --noEmit",
    "lint": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test --concurrency=1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "schema:status": "bun run scripts/schema.ts status",
    "schema:apply": "bun run scripts/schema.ts apply",
    "generate:client": "bun run scripts/generate-client.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:binary": "bun run build:admin && bun build --compile --minify src/cli/index.ts --outfile dist/base",
    "build:binary:all": "bun run build:admin && bun run scripts/build-binaries.ts",
    "cli": "bun run src/cli/index.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "bun-types": "1.3.14",
    "drizzle-kit": "^0.31.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
