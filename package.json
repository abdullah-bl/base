{
  "name": "@base/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index-public.ts",
    "./schema": "./src/schema/define.ts",
    "./client": "./src/client/generated.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --concurrency=1",
    "typecheck": "tsc --noEmit",
    "lint": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test --concurrency=1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "schema:status": "bun run scripts/schema.ts status",
    "schema:apply": "bun run scripts/schema.ts apply",
    "generate:client": "bun run scripts/generate-client.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.11.0",
    "bun-types": "1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
